# URL pública del sitio (sin barra final). Se usa para SEO y URLs de retorno de Mercado Pago.
PUBLIC_SITE_URL=https://ferralto.com

# Número de WhatsApp de ventas en formato internacional sin "+" ni espacios (ej: 5491123456789)
PUBLIC_WHATSAPP_NUMBER=5491131008720

# Mercado Pago — https://www.mercadopago.com.ar/developers/panel/app
# Usá las credenciales de PRUEBA en desarrollo y las de PRODUCCIÓN en el deploy.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Clave secreta de webhooks (Panel > Tu app > Webhooks > Clave secreta)
MP_WEBHOOK_SECRET=

# Opcional: Google Analytics 4 / Meta Pixel para medir campañas en redes
PUBLIC_GA_ID=
PUBLIC_META_PIXEL_ID=

# Google Ads: ID de etiqueta (AW-123456789), sin etiqueta de conversión.
PUBLIC_GOOGLE_ADS_ID=
# Opcionales: labels de acciones de conversión. Configurarlas como secundarias al inicio.
PUBLIC_ADS_WHATSAPP_LABEL=
PUBLIC_ADS_CHECKOUT_LABEL=

# Notion — pedidos del checkout. Crear una integración en https://www.notion.so/my-integrations
# y una base con estas propiedades: Pedido (título), Nombre (texto), Email (email),
# Teléfono (teléfono), Dirección (texto, dirección completa), Calle y número (texto),
# Piso / depto (texto, opcional), Localidad (texto), Código postal (texto), Notas (texto),
# Productos (texto), Total (número), Estado (selección: Pendiente, Pagado, Rechazado, WhatsApp),
# Canal (selección: Mercado Pago, WhatsApp).
# Si faltan las columnas de dirección, la integración las crea al guardar el primer pedido.
# Compartí la base con la integración y pegá el token y el ID de la base.
NOTION_TOKEN=
NOTION_DATABASE_ID=
