---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { categories, getProductsByCategory, type Category } from '@/lib/catalog';
import { buyingGuides } from '@/lib/buying-guides';
import { whatsappContactUrl } from '@/lib/whatsapp';
import { SITE } from '@/lib/site';

export const getStaticPaths = (() =>
  categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.props as { category: Category };
const items = getProductsByCategory(category.slug);
const categoryTitle = category.slug === 'escaleras' ? 'Escaleras Safari' : category.name;
const categoryDescription = category.slug === 'escaleras'
  ? 'Comprá escaleras Safari en Ferralto para tu hogar. Modelos de 2 a 7 peldaños y escalerita fija. Compará precios, medidas y colores; consultá tu envío antes de pagar.'
  : category.description;
const guide = buyingGuides[category.slug];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  mainEntity: { '@type': 'ItemList', itemListElement: items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, url: new URL(`/productos/${item.slug}`, SITE.url).href })) },
  name: categoryTitle,
  description: categoryDescription,
  url: new URL(`/categoria/${category.slug}`, SITE.url).href,
};
---

<BaseLayout title={`${categoryTitle} — comprá online`} description={categoryDescription} jsonLd={ld}>
  <div class="container-page py-10">
    <Breadcrumbs
      items={[
        { name: 'Productos', href: '/productos' },
        { name: category.name, href: `/categoria/${category.slug}` },
      ]}
    />
    <h1 class="mt-4 font-display text-5xl font-bold uppercase">{categoryTitle}</h1>
    <p class="mt-2 max-w-2xl text-steel">{categoryDescription}</p>
    {category.slug === 'escaleras' && <p class="mt-3 max-w-2xl text-steel">Ferralto vende al consumidor final: podés comprar una escalera Safari para tu casa y recibir asesoramiento para elegir el modelo.</p>}
    <p class="mt-4 text-sm font-semibold">Envíos a todo el país · Mercado Pago · Asesoramiento antes de comprar</p>
    <a class="mt-3 inline-block text-sm underline" href={whatsappContactUrl(`¡Hola! Necesito ayuda para elegir: ${category.name}.`)} target="_blank" rel="noopener">Te ayudamos a elegir →</a>
    <div class="mt-8" data-view-list={JSON.stringify({ item_list_id: category.slug, item_list_name: category.name, items: items.map((p, index) => ({ item_id: p.id, item_name: p.name, item_category: p.category, price: p.price, index })) })}>
      <ProductGrid products={items} />
    </div>
    {guide && <section class="mt-12 rounded-2xl border border-stone-200 bg-white p-6 sm:p-8" aria-labelledby="guide-title">
      <h2 id="guide-title" class="font-display text-3xl font-bold">{guide.title}</h2>
      <p class="mt-3 max-w-3xl text-steel">{guide.text}</p>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm">{guide.checks.map(check => <li>{check}</li>)}</ul>
      <a href="/como-comprar" class="mt-5 inline-block font-semibold underline">Consultá envíos, pagos y garantía</a>
    </section>}
  </div>
</BaseLayout>
