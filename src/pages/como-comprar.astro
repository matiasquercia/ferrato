---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';
const faqs = [
  {
    q: '¿Cómo compro?',
    a: 'Agregá los productos al carrito, completá tus datos y pagá con Mercado Pago. Si preferís, podés enviarnos el pedido por WhatsApp y lo coordinamos.',
  },
  {
    q: '¿Hacen envíos?',
    a: `Sí, enviamos a todo el país. El envío es gratis en compras desde $${SITE.freeShippingFrom.toLocaleString('es-AR')}. También podés retirar en ${SITE.city}.`,
  },
  {
    q: '¿Qué medios de pago aceptan?',
    a: 'Tarjetas de crédito y débito (con cuotas), dinero en cuenta de Mercado Pago, transferencia y efectivo en puntos de pago.',
  },
  {
    q: '¿Tienen garantía los productos?',
    a: 'Todos nuestros productos tienen garantía por defectos de fabricación. Escribinos por WhatsApp ante cualquier problema.',
  },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Cómo comprar, envíos y pagos"
  description="Cómo comprar en Ferrato: envíos a todo el país, medios de pago y garantía."
  jsonLd={ld}
>
  <div class="container-page max-w-3xl py-12">
    <h1 class="font-display text-5xl font-bold uppercase">Cómo comprar</h1>
    <div class="mt-8 space-y-4">
      {faqs.map((f, i) => (
        <details
          id={['comprar', 'envios', 'pagos', 'garantia'][i]}
          class="rounded-xl border border-stone-200 bg-white p-5"
          open={i === 0}
        >
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-3 text-steel">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>
