---
import BaseLayout from '@/layouts/BaseLayout.astro';
const faqs = [
  {
    q: '¿Cómo compro?',
    a: 'Agregá los productos al carrito, completá tus datos y pagá con Mercado Pago. Si preferís, podés enviarnos el pedido por WhatsApp y lo coordinamos.',
  },
  {
    q: '¿Hacen envíos?',
    a: 'Envío a domicilio en toda CABA (Capital Federal) por $15.000 para todo tu pedido. Fuera de CABA, los destinos de AMBA hasta 5 km a la redonda de Obispo San Alberto 3796 también pagan $15.000; el resto de AMBA paga $35.000 por pedido. El radio se mide en línea recta desde esa dirección hasta el domicilio de entrega, no por el recorrido en auto ni por el centro del barrio. La tarifa cercana se aplica a la dirección exacta: puede cubrir una parte de una localidad. El costo se suma al precio de los productos, sin mínimo de compra. Completá tu dirección, localidad y código postal en el carrito para confirmar la tarifa antes de pagar. Coordinamos el día de entrega por WhatsApp. Por ahora vendemos y hacemos envíos únicamente dentro de AMBA; no atendemos pedidos fuera de esta zona. Para retirar, coordiná previamente por WhatsApp.',
  },
  {
    q: '¿Qué medios de pago aceptan?',
    a: 'Tarjetas de crédito y débito (con cuotas), dinero en cuenta de Mercado Pago, transferencia y efectivo en puntos de pago.',
  },
  {
    q: '¿Tienen garantía los productos?',
    a: 'Todos nuestros productos tienen garantía por defectos de fabricación. Escribinos por WhatsApp ante cualquier problema.',
  },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Cómo comprar, envíos y pagos"
  description="Cómo comprar en Ferralto: venta y envíos solo dentro de AMBA, medios de pago y garantía."
  jsonLd={ld}
>
  <div class="container-page max-w-3xl py-12">
    <h1 class="font-display text-5xl font-bold uppercase">Cómo comprar</h1>
    <div class="mt-8 space-y-4">
      {faqs.map((f, i) => (
        <details
          id={['comprar', 'envios', 'pagos', 'garantia'][i]}
          class="rounded-xl border border-stone-200 bg-white p-5"
          open={i === 0 || i === 1}
        >
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-3 text-steel">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>
