---
import CheckoutResult from '@/components/CheckoutResult.astro';
import { verifiedPaymentReturn } from '@/lib/verified-payment.server';

export const prerender = false;

const result = await verifiedPaymentReturn(Astro, 'error');
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CheckoutResult
  tone={result.tone}
  clearCart={result.tone === 'success'}
  orderId={result.orderId}
  purchase={result.purchase}
  title={result.title}
  message={result.message}
/>
