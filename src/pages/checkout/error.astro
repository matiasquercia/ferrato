---
import CheckoutResult from '@/components/CheckoutResult.astro';
import { paymentReturnCopy, paymentReturnTone } from '@/lib/mercadopago-return';

export const prerender = false;

const tone = paymentReturnTone(Astro.url.searchParams, 'error');
const copy = paymentReturnCopy(tone);
const orderId = Astro.url.searchParams.get('external_reference') ?? '';
---

<CheckoutResult
  tone={tone}
  clearCart={tone !== 'error'}
  orderId={orderId}
  title={copy.title}
  message={copy.message}
/>
