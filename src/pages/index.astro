---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { categories, getFeaturedProducts, getProductsByCategory } from '@/lib/catalog';
import { SITE } from '@/lib/site';
import { productImage } from '@/lib/images';
import { getProductBySlug } from '@/lib/catalog';
import { whatsappContactUrl } from '@/lib/whatsapp';

const featured = getFeaturedProducts();
const heroProduct = getProductBySlug('escalera-safari-5-peldanos') ?? featured[0];
const categoryImage = (slug: string) => productImage(getProductsByCategory(slug)[0]?.images[0] ?? '', 320);
const icon =
  'width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const whatsappLogo =
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>';
const benefits = [
  {
    title: 'Envíos a todo el país',
    text: `Gratis en compras desde $${SITE.freeShippingFrom.toLocaleString('es-AR')}.`,
    tone: 'bg-brand-50 text-brand-700 ring-brand-100',
    svg: `<svg ${icon}><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
  },
  {
    title: 'Pagá en cuotas',
    text: 'Mercado Pago, tarjetas de crédito, débito o transferencia.',
    tone: 'bg-brand-50 text-brand-700 ring-brand-100',
    svg: `<svg ${icon}><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>`,
  },
  {
    title: 'Atención por WhatsApp',
    text: 'Te asesoramos antes y después de tu compra.',
    tone: 'bg-[#25D366]/10 text-[#25D366] ring-[#25D366]/20',
    svg: whatsappLogo,
    href: whatsappContactUrl('¡Hola! Quiero hacer una consulta.'),
  },
  {
    title: 'Fabricación nacional',
    text: 'Acero con tratamiento anticorrosivo y pintura epoxi.',
    tone: 'bg-brand-50 text-brand-700 ring-brand-100',
    svg: `<svg ${icon}><path d="M3 21V9.5a.5.5 0 0 1 .77-.42L9 12.5V9.5a.5.5 0 0 1 .77-.42L15 12.5V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v17"/><path d="M2 21h20"/><path d="M7 17h2M12 17h2M17 17h2"/></svg>`,
  },
];
---

<BaseLayout>
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="container-page grid items-center gap-10 py-16 md:grid-cols-2 md:py-24">
      <div>
        <p class="mb-3 inline-block rounded-full bg-brand-500/15 px-3 py-1 text-sm font-semibold text-brand-300">
          Escaleras, hogar y ferretería
        </p>
        <h1 class="font-display text-5xl leading-none font-bold uppercase sm:text-6xl lg:text-7xl">
          Llegá más alto
          <br />
          <span class="text-brand-500">con Ferrato</span>
        </h1>
        <p class="mt-5 max-w-lg text-lg text-stone-300">
          Escaleras, banquetas, tenders, tablas de planchar, agarraderas y ferretería. También
          trabajamos productos Safari. Comprá online y recibilo en tu casa.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/categoria/escaleras" class="btn-primary w-full sm:w-auto">
            Ver escaleras
          </a>
          <a href="/productos" class="btn w-full border border-stone-600 text-white hover:bg-stone-800 sm:w-auto">
            Todo el catálogo
          </a>
        </div>
      </div>
      <a
        href={`/productos/${heroProduct.slug}`}
        aria-label={heroProduct.name}
        class="mx-auto block w-full max-w-md overflow-hidden rounded-3xl bg-photo"
      >
        <img
          src={productImage(heroProduct.images[0], 900)}
          alt={heroProduct.name}
          width="900"
          height="900"
          fetchpriority="high"
          class="aspect-square h-full w-full object-cover"
        />
      </a>
    </div>
  </section>

  <section class="container-page py-10" aria-labelledby="benefits-title">
    <h2 id="benefits-title" class="sr-only">Por qué comprar en Ferrato</h2>
    <ul class="grid gap-px overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 shadow-[0_1px_2px_rgba(28,25,23,0.04),0_8px_24px_-12px_rgba(28,25,23,0.12)] sm:grid-cols-2 lg:grid-cols-4">
      {benefits.map((b) => {
        const Tag = b.href ? 'a' : 'div';
        return (
          <li class="bg-white">
            <Tag
              {...(b.href && { href: b.href, target: '_blank', rel: 'noopener' })}
              class:list={[
                'flex h-full items-center gap-4 px-6 py-6',
                b.href && 'group transition hover:bg-stone-50',
              ]}
            >
              <span
                class:list={['grid h-12 w-12 shrink-0 place-items-center rounded-full ring-1', b.tone]}
                set:html={b.svg}
              />
              <div class="min-w-0">
                <h3 class="text-[15px] leading-tight font-semibold text-ink">{b.title}</h3>
                <p class="mt-1 text-sm leading-snug text-steel">{b.text}</p>
                {b.href && (
                  <span class="mt-1.5 inline-block text-xs font-semibold text-[#128C7E] group-hover:underline">
                    Escribinos →
                  </span>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="container-page py-14" aria-labelledby="cat-title">
    <h2 id="cat-title" class="section-title">Categorías</h2>
    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-5">
      {categories.map((c) => (
        <a
          href={`/categoria/${c.slug}`}
          class="group overflow-hidden rounded-2xl border border-stone-300/80 bg-white text-center transition hover:border-brand-500 hover:shadow-md"
        >
          <img
            src={categoryImage(c.slug)}
            alt={c.name}
            width="320"
            height="320"
            class="aspect-square w-full object-cover"
          />
          <span class="mt-3 block px-3 font-semibold">{c.name}</span>
          <span class="mb-3 block text-xs text-steel">
            {getProductsByCategory(c.slug).length === 1
              ? '1 producto'
              : `${getProductsByCategory(c.slug).length} productos`}
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-page pb-6" aria-labelledby="feat-title">
    <div class="flex items-end justify-between">
      <h2 id="feat-title" class="section-title">Destacados</h2>
      <a href="/productos/todos" class="text-sm font-semibold text-brand-700 hover:underline">
        Ver todos →
      </a>
    </div>
    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {featured.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>
  </section>
</BaseLayout>
