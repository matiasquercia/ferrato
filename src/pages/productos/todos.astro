---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { categories, products } from '@/lib/catalog';
---

<BaseLayout
  title="Todos los productos"
  description="Catálogo de Ferrato: escaleras, tenders, banquetas, tablas de planchar y ferretería. Comprá online con envío a todo el país."
>
  <div class="container-page py-10">
    <Breadcrumbs
      items={[
        { name: 'Productos', href: '/productos' },
        { name: 'Todos', href: '/productos/todos' },
      ]}
    />
    <h1 class="mt-4 font-display text-5xl font-bold uppercase">Todos los productos</h1>
    <div class="mt-6 flex flex-wrap gap-2" data-category-filters>
      {categories.map((c) => (
        <button
          type="button"
          data-filter={c.slug}
          aria-pressed="false"
          class="rounded-full border border-stone-300 bg-white px-4 py-1.5 text-sm hover:border-brand-500 aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white"
        >
          {c.name}
        </button>
      ))}
    </div>
    <p data-filter-empty class="mt-8 hidden py-10 text-center text-steel">
      No hay productos con esos filtros.
    </p>
    <div class="mt-8" data-product-list>
      <ProductGrid products={products} />
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-product-list] [data-category]')];
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  const apply = () => {
    const selected = new Set(
      buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter),
    );
    let visible = 0;
    for (const card of cards) {
      const show = selected.size === 0 || selected.has(card.dataset.category);
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    }
    empty?.classList.toggle('hidden', visible > 0);
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      button.setAttribute('aria-pressed', button.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      apply();
    });
  }
</script>
