---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import AddToCartButton from '@/components/AddToCartButton';
import { getCategory, getRelatedProducts, maxQuantity, products, type Product } from '@/lib/catalog';
import { discountPercent, formatPrice } from '@/lib/format';
import { productImage } from '@/lib/images';
import { SITE } from '@/lib/site';
import { whatsappContactUrl } from '@/lib/whatsapp';

export const getStaticPaths = (() =>
  products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const category = getCategory(product.category)!;
const related = getRelatedProducts(product);
const off = product.price !== null ? discountPercent(product.price, product.compareAtPrice) : 0;
const url = new URL(`/productos/${product.slug}`, SITE.url).href;
const absImages = product.images.map((i) => new URL(productImage(i, 1200), SITE.url).href);

// Datos estructurados: habilitan rich results (precio, stock) en Google.
const productLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.sku,
  image: absImages,
  brand: { '@type': 'Brand', name: product.brand },
  category: category.name,
  ...(product.colors.length > 0 && { color: product.colors.join(', ') }),
};
if (product.price !== null) {
  productLd.offers = {
    '@type': 'Offer',
    url,
    priceCurrency: 'ARS',
    price: product.price,
    availability:
      product.stock === null || product.stock > 0
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: SITE.name },
  };
}
const metaPrice = product.price !== null ? ` ${formatPrice(product.price)}.` : '';
---

<BaseLayout
  title={product.name}
  description={`${product.shortDescription}${metaPrice} Envíos a todo el país.`}
  image={productImage(product.images[0], 1200)}
  jsonLd={productLd}
  ogType="product"
>
  <div class="container-page py-10">
    <Breadcrumbs
      items={[
        { name: category.name, href: `/categoria/${category.slug}` },
        { name: product.name, href: `/productos/${product.slug}` },
      ]}
    />

    <div class="mt-6 grid gap-10 md:grid-cols-2">
      <div data-gallery>
        <button
          type="button"
          data-gallery-open
          class="relative block w-full cursor-zoom-in overflow-hidden rounded-3xl border border-stone-300/80 bg-photo"
          aria-label="Ampliar imagen"
        >
          <img
            data-gallery-main
            src={productImage(product.images[0], 1000)}
            alt={product.name}
            width="1000"
            height="1000"
            fetchpriority="high"
            class="aspect-square h-full w-full object-cover"
          />
          {off > 0 && (
            <span class="absolute top-4 left-4 rounded-full bg-red-600 px-3 py-1 text-sm font-bold text-white">
              -{off}%
            </span>
          )}
          <span
            class="absolute right-4 bottom-4 rounded-full bg-ink/80 px-3 py-1 text-xs font-semibold text-white"
          >
            Ampliar
          </span>
        </button>
        {product.images.length > 1 && (
          <div class="mt-3 grid grid-cols-5 gap-2">
            {product.images.map((img, i) => (
              <button
                type="button"
                data-gallery-thumb={productImage(img, 1600)}
                data-index={i}
                aria-label={`Ver imagen ${i + 1}`}
                class:list={[
                  'aspect-square overflow-hidden rounded-xl border-2 bg-photo',
                  i === 0 ? 'border-ink' : 'border-stone-200 hover:border-stone-400',
                ]}
              >
                <img
                  src={productImage(img, 200)}
                  alt=""
                  width="200"
                  height="200"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </button>
            ))}
          </div>
        )}

        <dialog
          data-lightbox
          class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none border-0 bg-black/90 p-0 text-white backdrop:bg-black/80"
          aria-label={`Fotos de ${product.name}`}
        >
          <div class="flex h-full flex-col">
            <div class="flex items-center justify-between px-4 py-3">
              <p data-lightbox-count class="text-sm font-semibold"></p>
              <button
                type="button"
                data-lightbox-close
                class="rounded-full px-3 py-2 text-sm font-semibold hover:bg-white/10"
              >
                Cerrar
              </button>
            </div>
            <div class="relative flex min-h-0 flex-1 items-center justify-center px-14">
              <button
                type="button"
                data-lightbox-prev
                class:list={[
                  'absolute left-3 grid h-11 w-11 place-items-center rounded-full bg-white/15 text-2xl hover:bg-white/25',
                  product.images.length < 2 && 'hidden',
                ]}
                aria-label="Foto anterior"
              >
                ‹
              </button>
              <img data-lightbox-img alt="" class="max-h-full max-w-full object-contain" />
              <button
                type="button"
                data-lightbox-next
                class:list={[
                  'absolute right-3 grid h-11 w-11 place-items-center rounded-full bg-white/15 text-2xl hover:bg-white/25',
                  product.images.length < 2 && 'hidden',
                ]}
                aria-label="Foto siguiente"
              >
                ›
              </button>
            </div>
          </div>
        </dialog>
      </div>

      <div>
        <p class="text-sm font-semibold tracking-wide text-steel uppercase">
          {product.brand} · Cód. {product.sku}
        </p>
        <h1 class="mt-2 font-display text-4xl leading-tight font-bold uppercase sm:text-5xl">
          {product.name}
        </h1>
        <div class="mt-4 flex items-baseline gap-3">
          {product.price !== null ? (
            <>
              <span class="text-4xl font-bold">{formatPrice(product.price)}</span>
              {off > 0 && (
                <span class="text-lg text-stone-400 line-through">
                  {formatPrice(product.compareAtPrice!)}
                </span>
              )}
            </>
          ) : (
            <span class="text-2xl font-semibold text-steel">Precio a consultar</span>
          )}
        </div>
        {product.price !== null && <p class="mt-1 text-sm text-steel">Pagá en cuotas con Mercado Pago</p>}
        <p class="mt-5 text-lg">{product.shortDescription}</p>
        {product.stock !== null && (
          <p
            class:list={['mt-4 text-sm font-semibold', product.stock > 0 ? 'text-green-700' : 'text-red-600']}
          >
            {product.stock > 0 ? `✓ En stock (${product.stock} disponibles)` : 'Sin stock'}
          </p>
        )}

        <AddToCartButton
          client:load
          withQuantity
          product={{
            id: product.id,
            slug: product.slug,
            name: product.name,
            price: product.price,
            image: product.images[0],
            maxStock: maxQuantity(product),
            colors: product.colors,
          }}
        />
        {product.price !== null && (
          <a
            href={whatsappContactUrl(`¡Hola! Quiero consultar por: ${product.name} (${url})`)}
            target="_blank"
            rel="noopener"
            class="btn mt-3 w-full border border-stone-300 bg-white hover:bg-stone-50"
          >
            Consultar por WhatsApp
          </a>
        )}

        <h2 class="section-title mt-10">Descripción</h2>
        <p class="mt-2 text-steel">{product.description}</p>

        <h2 class="section-title mt-8">Especificaciones</h2>
        <dl class="mt-3 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
          {Object.entries(product.specs).map(([k, v]) => (
            <div class="flex justify-between gap-4 px-4 py-2.5 text-sm">
              <dt class="text-steel">{k}</dt>
              <dd class="text-right font-semibold">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-16">
        <h2 class="section-title">También te puede interesar</h2>
        <div class="mt-6">
          <ProductGrid products={related} />
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const openBtn = gallery.querySelector<HTMLButtonElement>('[data-gallery-open]');
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lightboxImg = gallery.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const count = gallery.querySelector<HTMLElement>('[data-lightbox-count]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const closeBtn = gallery.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const sources = thumbs.length
      ? thumbs.map((t) => t.dataset.galleryThumb!)
      : [main?.src ?? ''].filter(Boolean);
    let index = 0;

    const markThumb = () => {
      thumbs.forEach((t, i) => {
        t.classList.toggle('border-ink', i === index);
        t.classList.toggle('border-stone-200', i !== index);
      });
    };

    const show = (nextIndex: number) => {
      index = (nextIndex + sources.length) % sources.length;
      const src = sources[index];
      if (main) main.src = src;
      if (lightboxImg) {
        lightboxImg.src = src;
        lightboxImg.alt = `${main?.alt ?? 'Foto'} ${index + 1} de ${sources.length}`;
      }
      if (count) count.textContent = `${index + 1} / ${sources.length}`;
      const single = sources.length < 2;
      prev?.classList.toggle('hidden', single);
      next?.classList.toggle('hidden', single);
      markThumb();
    };

    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)));

    const open = () => {
      if (!dialog) return;
      show(index);
      dialog.showModal();
    };
    openBtn?.addEventListener('click', open);

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    closeBtn?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    dialog?.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    dialog?.addEventListener('pointerup', (event) => {
      if ((event.target as HTMLElement).closest('button')) return;
      const delta = event.clientX - startX;
      if (delta > 50) show(index - 1);
      if (delta < -50) show(index + 1);
    });
  });
</script>
