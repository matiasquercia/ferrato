---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { categories, getProductsByCategory, products } from '@/lib/catalog';
import { productImage } from '@/lib/images';

const categoryImage = (slug: string) => productImage(getProductsByCategory(slug)[0]?.images[0] ?? '', 500);
const countLabel = (n: number) => (n === 1 ? '1 producto' : `${n} productos`);
---

<BaseLayout
  title="Productos"
  description="Categorías de Ferralto: escaleras, banquetas, tenders, tablas de planchar, agarraderas y todo el catálogo."
>
  <div class="container-page py-10">
    <Breadcrumbs items={[{ name: 'Productos', href: '/productos' }]} />
    <h1 class="mt-4 font-display text-5xl font-bold uppercase">Productos</h1>
    <div class="category-grid mt-8">
      <a
        href="/productos/todos"
        class="group overflow-hidden rounded-2xl border border-stone-300/80 bg-white text-center transition hover:border-brand-500 hover:shadow-md"
      >
        <span class="grid aspect-square grid-cols-2">
          {categories.slice(0, 4).map((c) => (
            <img src={categoryImage(c.slug)} alt="" width="250" height="250" class="h-full w-full object-cover" />
          ))}
        </span>
        <span class="mt-3 block px-3 font-semibold">Todos</span>
        <span class="mb-3 block text-xs text-steel">{countLabel(products.length)}</span>
      </a>
      {categories.map((c) => (
        <a
          href={`/categoria/${c.slug}`}
          class="group overflow-hidden rounded-2xl border border-stone-300/80 bg-white text-center transition hover:border-brand-500 hover:shadow-md"
        >
          <img
            src={categoryImage(c.slug)}
            alt={c.name}
            width="500"
            height="500"
            class="aspect-square w-full object-cover"
          />
          <span class="mt-3 block px-3 font-semibold">{c.name}</span>
          <span class="mb-3 block text-xs text-steel">{countLabel(getProductsByCategory(c.slug).length)}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
