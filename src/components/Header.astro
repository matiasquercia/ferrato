---
import CartButton from './CartButton';
import { categories } from '@/lib/catalog';
import { SITE } from '@/lib/site';

const path = Astro.url.pathname;
---

<div class="bg-ink text-center text-sm text-stone-200">
  <p class="container-page py-2">
    🚚 Envío gratis en compras desde{' '}
    <strong class="text-brand-300">${SITE.freeShippingFrom.toLocaleString('es-AR')}</strong> · Pagá en cuotas
    con Mercado Pago
  </p>
</div>
<header class="sticky top-0 z-30 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="Ferrato, inicio">
      <img src="/logo.png" alt="Ferrato" width="165" height="40" class="h-10 w-auto" />
    </a>

    <nav aria-label="Categorías" class="hidden items-center gap-6 lg:flex">
      {categories.map((c) => (
        <a
          href={`/categoria/${c.slug}`}
          class:list={[
            'text-sm font-semibold transition hover:text-brand-700',
            path.startsWith(`/categoria/${c.slug}`) ? 'text-brand-700' : 'text-steel',
          ]}
        >
          {c.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/productos/todos" class="hidden text-sm font-semibold text-steel hover:text-ink sm:inline">
        Ver todo
      </a>
      <CartButton client:load />
      <details class="relative lg:hidden">
        <summary class="list-none rounded-lg p-2 hover:bg-stone-100" aria-label="Abrir menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <nav
          aria-label="Menú móvil"
          class="absolute right-0 mt-2 w-56 rounded-xl border border-stone-200 bg-white p-2 shadow-lg"
        >
          <a href="/productos" class="block rounded-lg px-3 py-2 font-semibold hover:bg-stone-100">
            Productos
          </a>
          <a href="/productos/todos" class="block rounded-lg px-3 py-2 hover:bg-stone-100">
            Todos
          </a>
          {categories.map((c) => (
            <a href={`/categoria/${c.slug}`} class="block rounded-lg px-3 py-2 hover:bg-stone-100">
              {c.name}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
