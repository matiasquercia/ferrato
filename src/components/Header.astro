---
import CartButton from './CartButton';
import { categories } from '@/lib/catalog';
import { DELIVERY_PRICES } from '@/lib/delivery';
import { formatPrice } from '@/lib/format';

const path = Astro.url.pathname;
---

<div class="bg-ink text-sm text-stone-200">
  <a href="/como-comprar#envios" class="container-page flex min-h-11 flex-wrap items-center justify-center gap-x-4 gap-y-1 py-3 text-center focus-visible:outline-2 focus-visible:outline-brand-500">
    <span class="inline-flex items-center justify-center gap-2 font-semibold text-white">
      <svg class="shrink-0 text-brand-300" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 18V6H2v12h3m4 0h6m-1-10h4l4 5v5h-3"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
      <span>Envío a domicilio en CABA por <strong class="whitespace-nowrap text-brand-300">{formatPrice(DELIVERY_PRICES.caba)}</strong></span>
    </span>
    <span>AMBA hasta 5 km: <strong class="whitespace-nowrap text-brand-300">{formatPrice(DELIVERY_PRICES.nearby)}</strong> · <span class="whitespace-nowrap">Resto: <strong class="text-brand-300">{formatPrice(DELIVERY_PRICES.amba)}</strong> <span aria-hidden="true">→</span></span></span>
  </a>
</div>
<header class="sticky top-0 z-30 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Ferralto, inicio">
      <img src="/logo.png" alt="Ferralto" width="980" height="237" class="h-auto w-36 sm:w-44" />
    </a>

    <nav aria-label="Categorías" class="hidden items-center gap-6 lg:flex">
      {categories.map((c) => (
        <a
          href={`/categoria/${c.slug}`}
          class:list={[
            'text-sm font-semibold transition hover:text-brand-700',
            path.startsWith(`/categoria/${c.slug}`) ? 'text-brand-700' : 'text-steel',
          ]}
        >
          {c.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/productos/todos" class="hidden text-sm font-semibold text-steel hover:text-ink sm:inline">
        Ver todo
      </a>
      <CartButton client:load />
      <details class="relative lg:hidden">
        <summary class="grid min-h-11 min-w-11 list-none place-items-center rounded-lg p-2 hover:bg-stone-100" aria-label="Abrir menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <nav
          aria-label="Menú móvil"
          class="mobile-menu absolute right-0 mt-2 w-56 rounded-xl border border-stone-200 bg-white p-2 shadow-lg"
        >
          <a href="/productos" class="block rounded-lg px-3 py-2 font-semibold hover:bg-stone-100">
            Productos
          </a>
          <a href="/productos/todos" class="block rounded-lg px-3 py-2 hover:bg-stone-100">
            Todos
          </a>
          {categories.map((c) => (
            <a href={`/categoria/${c.slug}`} class="block rounded-lg px-3 py-2 hover:bg-stone-100">
              {c.name}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
