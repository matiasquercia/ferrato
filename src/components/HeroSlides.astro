---
const slides = [
  { file: 'workshop-v2', label: 'Herramientas', pos: 'right center', posMobile: '88% 62%' },
  { file: 'tender', label: 'Tenders', pos: 'right center', posMobile: '72% 42%' },
  { file: 'escalera', label: 'Escaleras', pos: 'right center', posMobile: '80% 48%' },
  { file: 'hogar', label: 'Hogar', pos: 'right center', posMobile: '78% 45%' },
];
---
{slides.map((slide, i) => (
  <img
    class:list={['hero-background', 'hero-slide', { 'is-active': i === 0 }]}
    style={`--hero-pos: ${slide.pos}; --hero-pos-mobile: ${slide.posMobile};`}
    src={i === 0 ? `/images/hero/${slide.file}-1672.webp` : undefined}
    srcset={i === 0 ? `/images/hero/${slide.file}-960.webp 960w, /images/hero/${slide.file}-1672.webp 1672w` : undefined}
    data-src={`/images/hero/${slide.file}-1672.webp`}
    data-srcset={`/images/hero/${slide.file}-960.webp 960w, /images/hero/${slide.file}-1672.webp 1672w`}
    sizes="100vw"
    alt=""
    width="1672"
    height="941"
    fetchpriority={i === 0 ? 'high' : 'low'}
    decoding={i === 0 ? 'auto' : 'async'}
  />
))}
<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const images = [...hero.querySelectorAll<HTMLImageElement>('.hero-slide')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 767px)');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let current = 0;
    let generation = 0;
    let visible = true;
    let timer: ReturnType<typeof setTimeout> | undefined;

    async function load(index: number) {
      const img = images[index];
      if (!img.getAttribute('src')) {
        img.srcset = img.dataset.srcset!;
        img.src = img.dataset.src!;
      }
      await img.decode();
    }

    function schedule() {
      clearTimeout(timer);
      if (!reduced.matches && !mobile.matches && !connection?.saveData && visible && !document.hidden) {
        timer = setTimeout(() => {
          void show(current + 1);
        }, 5500);
      }
    }

    async function show(index: number) {
      const ticket = ++generation;
      index = (index + images.length) % images.length;
      try {
        await load(index);
      } catch {
        schedule();
        return;
      }
      if (ticket !== generation) return;
      images[current].classList.remove('is-active');
      images[index].classList.add('is-active');
      current = index;
      schedule();
    }

    document.addEventListener('visibilitychange', schedule);
    reduced.addEventListener('change', schedule);
    mobile.addEventListener('change', schedule);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      schedule();
    }).observe(hero);
    schedule();
  }
</script>
<style is:global>
  .hero-slide {
    opacity: 0;
    transition: opacity 800ms ease;
  }
  .hero-slide.is-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: none;
    }
  }
</style>
