---
const slides = [
  { file: 'workshop-v2', label: 'Herramientas' },
  { file: 'tender', label: 'Tenders' },
  { file: 'escalera', label: 'Escaleras' },
  { file: 'hogar', label: 'Hogar' },
];
---
{slides.map((slide, i) => <img
  class:list={['hero-background', 'hero-slide', { 'is-active': i === 0 }]}
  src={i === 0 ? `/images/hero/${slide.file}-1672.webp` : undefined}
  srcset={i === 0 ? `/images/hero/${slide.file}-960.webp 960w, /images/hero/${slide.file}-1672.webp 1672w` : undefined}
  data-src={`/images/hero/${slide.file}-1672.webp`}
  data-srcset={`/images/hero/${slide.file}-960.webp 960w, /images/hero/${slide.file}-1672.webp 1672w`}
  sizes="100vw" alt="" width="1672" height="941"
  fetchpriority={i === 0 ? 'high' : 'low'} decoding={i === 0 ? 'auto' : 'async'}
/>)}
<div class="hero-carousel-controls" hidden aria-label="Fotos del hero">
  <button type="button" data-play aria-label="Pausar fotos">Ⅱ</button>
  <button type="button" data-prev aria-label="Foto anterior">←</button>
  <div class="hero-dots">
    {slides.map((slide, i) => <button type="button" data-slide={i} aria-label={`Ver foto de ${slide.label.toLowerCase()}`} aria-pressed={i === 0}><span></span></button>)}
  </div>
  <button type="button" data-next aria-label="Foto siguiente">→</button>
  <span data-caption>01 / 04 · Herramientas</span>
</div>
<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const images = [...hero.querySelectorAll<HTMLImageElement>('.hero-slide')];
    const controls = hero.querySelector<HTMLElement>('.hero-carousel-controls')!;
    const play = controls.querySelector<HTMLButtonElement>('[data-play]')!;
    const dots = [...controls.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const labels = ['Herramientas', 'Tenders', 'Escaleras', 'Hogar'];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0, generation = 0;
    let playing = !reduced.matches;
    let timer: ReturnType<typeof setTimeout> | undefined;
    hero.querySelector('#hero-controls-slot')?.append(controls);
    controls.hidden = false;
    function updatePlay() {
      play.textContent = playing ? 'Ⅱ' : '▶';
      play.setAttribute('aria-label', playing ? 'Pausar fotos' : 'Reproducir fotos');
    }
    async function load(index: number) {
      const img = images[index];
      if (!img.getAttribute('src')) {
        img.srcset = img.dataset.srcset!;
        img.src = img.dataset.src!;
      }
      await img.decode();
    }
    function schedule() {
      clearTimeout(timer);
      if (playing && !document.hidden && !hero!.matches(':hover, :focus-within')) {
        timer = setTimeout(() => { void show(current + 1); }, 6000);
      }
    }
    async function show(index: number) {
      const ticket = ++generation;
      index = (index + images.length) % images.length;
      try { await load(index); } catch { schedule(); return; }
      if (ticket !== generation) return;
      images[current].classList.remove('is-active');
      images[index].classList.add('is-active');
      current = index;
      dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === current)));
      controls.querySelector('[data-caption]')!.textContent = `0${current + 1} / 04 · ${labels[current]}`;
      schedule();
    }
    function manual(index: number) { playing = false; updatePlay(); clearTimeout(timer); void show(index); }
    dots.forEach((dot, i) => dot.addEventListener('click', () => manual(i)));
    controls.querySelector('[data-prev]')!.addEventListener('click', () => manual(current - 1));
    controls.querySelector('[data-next]')!.addEventListener('click', () => manual(current + 1));
    play.addEventListener('click', () => { playing = !playing; updatePlay(); schedule(); });
    hero.addEventListener('mouseenter', schedule);
    hero.addEventListener('mouseleave', schedule);
    hero.addEventListener('focusin', schedule);
    hero.addEventListener('focusout', () => setTimeout(schedule, 0));
    document.addEventListener('visibilitychange', schedule);
    reduced.addEventListener('change', () => { playing = !reduced.matches; updatePlay(); schedule(); });
    updatePlay();
    schedule();
  }
</script>
<style is:global>
  .hero-slide { opacity: 0; transition: opacity 800ms ease; }
  .hero-slide.is-active { opacity: 1; }
  .hero-carousel-controls { display: flex; align-items: center; gap: .25rem; }
  .hero-carousel-controls[hidden] { display: none; }
  .hero-carousel-controls button { width: 44px; height: 44px; cursor: pointer; color: white; border-radius: 50%; }
  .hero-carousel-controls button:hover { background: #ffffff20; }
  .hero-carousel-controls button:focus-visible { outline: 2px solid #eeb34d; outline-offset: 2px; }
  .hero-dots { display: flex; }
  .hero-dots button { width: 30px; }
  .hero-dots button span { display: block; width: 6px; height: 6px; background: #ffffff70; border-radius: 50%; margin: auto; }
  .hero-dots button[aria-pressed='true'] span { background: #eeb34d; box-shadow: 0 0 0 4px #eeb34d25; }
  .hero-carousel-controls [data-caption] { min-width: 150px; margin-left: 1rem; font-size: .7rem; letter-spacing: .04em; }
  @media (max-width: 767px) {
    .hero-photo .hero-index { justify-content: center; padding-top: .5rem; padding-bottom: .5rem; }
    .hero-carousel-controls [data-caption] { min-width: 0; margin-left: .25rem; font-size: .6rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-slide { transition: none; } }
</style>

